---
export interface Props {
  title: string;
  description: string;
  /** path-relative or absolute URL of the social image */
  image?: string;
  /** "website" | "article" */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** extra JSON-LD object(s) to inject (Article, BreadcrumbList, ...) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'Investiraj Pametno';
// Always canonicalize WITH a trailing slash so the canonical tag matches the
// served URL and the sitemap (trailingSlash: 'always'). No trailing-slash
// stripping — that previously made canonical disagree with both.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Site-wide Organization schema, always present.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: Astro.site?.href,
  description: 'Pametno upravljanje novcem i investiranje — bez magije i bez kockanja.',
  logo: new URL('/android-chrome-512.png', Astro.site).href,
  image: new URL('/og-default.png', Astro.site).href,
};

const extra = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const blocks = [orgSchema, ...extra];
---
<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="sr_RS" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Structured data -->
{blocks.map((b) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(b)} />
))}
