---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const dateStr = d.pubDate.toLocaleDateString('sr-RS', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const url = new URL(`/blog/${post.id}`, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'Investiraj Pametno' },
  publisher: { '@type': 'Organization', name: 'Investiraj Pametno' },
  mainEntityOfPage: url,
  inLanguage: 'sr-RS',
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Početna', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
---
<BaseLayout
  title={`${d.title} — Investiraj Pametno`}
  description={d.description}
  type="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate ?? d.pubDate}
  jsonLd={[articleSchema, breadcrumb]}
>
  <article>
    <header class="art-head">
      <div class="container narrow">
        <nav class="crumbs" aria-label="Putanja">
          <a href="/">Početna</a><span aria-hidden="true">/</span>
          <a href="/blog">Blog</a><span aria-hidden="true">/</span>
          <span aria-current="page">{d.category}</span>
        </nav>
        <p class="label">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
        <div class="byline">
          <time datetime={d.pubDate.toISOString()}>{dateStr}</time>
          {d.updatedDate && <span>· ažurirano</span>}
        </div>
      </div>
    </header>

    <div class="container narrow">
      <div class="prose-body">
        <Content />
      </div>

      <aside class="cta-box">
        <h2>Spreman da kreneš?</h2>
        <p>Ako te ovo nateralo na razmišljanje, ne staj ovde. Sedam koraka koji te vode do finansijske slobode čekaju te na jednom mestu.</p>
        <a href="/blog/7-koraka-do-finansijske-slobode" class="btn btn-primary">Pogledaj 7 koraka →</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow { width: min(100% - 2.4rem, 760px); }
  .art-head { background: var(--navy-700); color: var(--text-on-dark); padding-block: clamp(2.5rem, 5vw, 4rem); }
  .crumbs { font-size: 0.85rem; color: var(--text-on-dark-dim); display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; margin-bottom: 1.6rem; padding-block: 0.4rem; line-height: 1; }
  .crumbs a { color: var(--text-on-dark-dim); text-decoration: none; display: inline-flex; align-items: center; height: 40px; padding: 0 0.9rem; border-radius: 8px; background: rgba(255,255,255,0.05); }
  .crumbs a:hover { background: rgba(255,255,255,0.12); color: #fff; }
  .crumbs span[aria-hidden] { opacity: 0.5; }
  .crumbs a:hover { color: #fff; }
  .art-head h1 { color: #fff; font-size: var(--step-4); margin: 0.4rem 0 0.8rem; }
  .art-head .lede { color: var(--text-on-dark-dim); font-size: var(--step-1); line-height: 1.5; }
  .byline { margin-top: 1.2rem; font-size: 0.85rem; color: #7e95b3; display: flex; gap: 0.5rem; }

  .prose-body { padding-block: var(--space-xl); font-size: 1.12rem; line-height: 1.75; color: var(--text-on-light); }
  .prose-body :global(h2) { font-size: var(--step-2); margin: 2.2rem 0 0.8rem; }
  .prose-body :global(h3) { font-size: var(--step-1); margin: 1.8rem 0 0.6rem; }
  .prose-body :global(p) { margin-bottom: 1.2rem; }
  .prose-body :global(ul), .prose-body :global(ol) { margin: 0 0 1.2rem 1.3rem; }
  .prose-body :global(li) { margin-bottom: 0.5rem; }
  .prose-body :global(blockquote) {
    border-left: 4px solid var(--emerald); margin: 1.6rem 0; padding: 0.4rem 0 0.4rem 1.3rem;
    font-style: italic; color: var(--text-on-light-dim); font-size: 1.2rem;
  }
  .prose-body :global(a) { color: #0c7a5c; font-weight: 500; }
  .prose-body :global(strong) { color: var(--ink); }
  .prose-body :global(hr) { border: none; border-top: 1px solid var(--paper-line); margin: 2rem 0; }

  .cta-box {
    background: var(--paper-soft); border: 1px solid var(--paper-line);
    border-radius: var(--radius); padding: 2rem; margin-bottom: var(--space-2xl); text-align: center;
  }
  .cta-box h2 { font-size: var(--step-2); margin-bottom: 0.6rem; }
  .cta-box p { color: var(--text-on-light-dim); max-width: 50ch; margin: 0 auto 1.4rem; }
</style>
