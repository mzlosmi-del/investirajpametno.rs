---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const d = post.data;

const dateStr = d.pubDate.toLocaleDateString('sr-RS', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const url = new URL(`/blog/${post.id}/`, Astro.site).href;

// Compute an absolute URL for the hero image so og:image and Article.image resolve fully.
let heroUrl: string | undefined;
if (d.heroImage) {
  const optimized = await getImage({ src: d.heroImage, width: 1200, format: 'jpg' });
  heroUrl = new URL(optimized.src, Astro.site).href;
}

// Rough word count from raw markdown body (good enough for schema).
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  ...(heroUrl ? { image: [heroUrl] } : {}),
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'Investiraj Pametno', url: Astro.site?.href },
  publisher: {
    '@type': 'Organization',
    name: 'Investiraj Pametno',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/android-chrome-512.png', Astro.site).href,
      width: 512,
      height: 512,
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'sr-Latn-RS',
  wordCount,
  articleSection: d.category,
  keywords: d.tags?.join(', '),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Početna', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};

// Optional FAQPage schema — only when the post defines an faq.
const faqSchema = d.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

// Optional HowTo schema — emitted only when the post frontmatter carries one via
// remark frontmatter override. For now we look for `howTo` on the post data via
// remarkPluginFrontmatter (forward-compatible) or fall back to post.data.howTo.
const howToData = (remarkPluginFrontmatter as Record<string, unknown> | undefined)?.howTo
  ?? (d as unknown as { howTo?: { name: string; totalTime?: string; tool?: string; steps: { name: string; text: string }[] } }).howTo;
const howToSchema = howToData
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: howToData.name,
      ...(howToData.totalTime ? { totalTime: howToData.totalTime } : {}),
      ...(howToData.tool ? { tool: [{ '@type': 'HowToTool', name: howToData.tool }] } : {}),
      supply: [],
      step: howToData.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text,
      })),
    }
  : null;

const schemas = [
  articleSchema,
  breadcrumb,
  ...(faqSchema ? [faqSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
];
---
<BaseLayout
  title={`${d.seoTitle ?? d.title} — Investiraj Pametno`}
  description={d.description}
  type="article"
  image={heroUrl}
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate ?? d.pubDate}
  jsonLd={schemas}
>
  <article>
    <header class="art-head">
      <div class="container narrow">
        <nav class="crumbs" aria-label="Putanja">
          <a href="/">Početna</a><span aria-hidden="true">/</span>
          <a href="/blog">Blog</a><span aria-hidden="true">/</span>
          <span aria-current="page">{d.category}</span>
        </nav>
        <p class="label">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
        <div class="byline">
          <time datetime={d.pubDate.toISOString()}>{dateStr}</time>
          {d.updatedDate && <span>· ažurirano</span>}
        </div>
      </div>
    </header>

    {d.heroImage && (
      <div class="container narrow hero-wrap">
        <Image
          src={d.heroImage}
          alt={d.heroImageAlt ?? d.title}
          widths={[480, 760, 1100]}
          sizes="(max-width: 800px) 100vw, 760px"
          class="hero-img"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    <div class="container narrow">
      <div class="prose-body">
        <Content />
      </div>

      {d.faq?.length && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Česta pitanja</h2>
          {d.faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
      )}

      <aside class="cta-box">
        <h2>Spreman da kreneš?</h2>
        <p>Ako te ovo nateralo na razmišljanje, ne staj ovde. Sedam koraka koji te vode do finansijske slobode čekaju te na jednom mestu.</p>
        <a href="/blog/7-koraka-do-finansijske-slobode" class="btn btn-primary">Pogledaj 7 koraka →</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow { width: min(100% - 2.4rem, 760px); }
  .hero-wrap { margin-top: -2.5rem; margin-bottom: 0.5rem; position: relative; z-index: 1; }
  .hero-img {
    width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover;
    border-radius: var(--radius); box-shadow: var(--shadow-lift); display: block;
  }
  .art-head { background: var(--navy-700); color: var(--text-on-dark); padding-block: clamp(2.5rem, 5vw, 4rem); }
  .crumbs { font-size: 0.85rem; color: var(--text-on-dark-dim); display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; margin-bottom: 1.6rem; padding-block: 0.4rem; line-height: 1; }
  .crumbs a { color: var(--text-on-dark-dim); text-decoration: none; display: inline-flex; align-items: center; height: 40px; padding: 0 0.9rem; border-radius: 8px; background: rgba(255,255,255,0.05); }
  .crumbs a:hover { background: rgba(255,255,255,0.12); color: #fff; }
  .crumbs span[aria-hidden] { opacity: 0.5; }
  .crumbs a:hover { color: #fff; }
  .art-head h1 { color: #fff; font-size: var(--step-4); margin: 0.4rem 0 0.8rem; }
  .art-head .lede { color: var(--text-on-dark-dim); font-size: var(--step-1); line-height: 1.5; }
  .byline { margin-top: 1.2rem; font-size: 0.85rem; color: #7e95b3; display: flex; gap: 0.5rem; }

  .prose-body { padding-block: var(--space-xl); font-size: 1.12rem; line-height: 1.75; color: var(--text-on-light); }
  .prose-body :global(h2) { font-size: var(--step-2); margin: 2.2rem 0 0.8rem; }
  .prose-body :global(h3) { font-size: var(--step-1); margin: 1.8rem 0 0.6rem; }
  .prose-body :global(p) { margin-bottom: 1.2rem; }
  .prose-body :global(ul), .prose-body :global(ol) { margin: 0 0 1.2rem 1.3rem; }
  .prose-body :global(li) { margin-bottom: 0.5rem; }
  .prose-body :global(blockquote) {
    border-left: 4px solid var(--emerald); margin: 1.6rem 0; padding: 0.4rem 0 0.4rem 1.3rem;
    font-style: italic; color: var(--text-on-light-dim); font-size: 1.2rem;
  }
  .prose-body :global(a) { color: #0c7a5c; font-weight: 500; }
  .prose-body :global(strong) { color: var(--ink); }
  .prose-body :global(hr) { border: none; border-top: 1px solid var(--paper-line); margin: 2rem 0; }
  .prose-body :global(img) {
    width: 100%; height: auto; border-radius: var(--radius);
    margin: 1.8rem 0; box-shadow: var(--shadow-soft); display: block;
  }

  .faq { margin-bottom: var(--space-xl); }
  .faq h2 { font-size: var(--step-2); margin-bottom: 1.2rem; }
  .faq-item {
    border: 1px solid var(--paper-line); border-radius: var(--radius-sm);
    margin-bottom: 0.7rem; background: var(--paper); overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer; padding: 1rem 1.2rem; font-weight: 600; font-size: 1.05rem;
    color: var(--ink); list-style: none; display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--emerald-text); font-weight: 700; font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item summary:hover { color: var(--emerald-text); }
  .faq-item p { padding: 0 1.2rem 1.2rem; color: var(--text-on-light-dim); line-height: 1.65; }

  .cta-box {
    background: var(--paper-soft); border: 1px solid var(--paper-line);
    border-radius: var(--radius); padding: 2rem; margin-bottom: var(--space-2xl); text-align: center;
  }
  .cta-box h2 { font-size: var(--step-2); margin-bottom: 0.6rem; }
  .cta-box p { color: var(--text-on-light-dim); max-width: 50ch; margin: 0 auto 1.4rem; }
</style>
