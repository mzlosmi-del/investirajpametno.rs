---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'kontakt@investirajpametno.rs';
const instagram = 'https://instagram.com/investiraj_pametno';
---
<BaseLayout
  title="Kontakt — Investiraj Pametno"
  description="Pitanje, predlog teme ili saradnja? Javi se. Tu smo da pričamo o parama otvoreno."
>
  <header class="page-head">
    <div class="container narrow">
      <p class="label">Kontakt</p>
      <h1>Imaš pitanje? Pucaj.</h1>
      <p class="lede">
        Predlog teme, pitanje o investiranju ili ideja za saradnju — piši slobodno.
        Trudimo se da odgovorimo na svaku poruku.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container narrow">
      <div class="card">
        <p class="kicker">Piši nam direktno</p>
        <a class="mail" href={`mailto:${email}`}>{email}</a>
        <p class="note">Odgovaramo na svaku poruku — daj nam koji dan.</p>

        <div class="divider" role="presentation"></div>

        <p class="kicker">Prati nas</p>
        <ul class="social">
          <li><a href={instagram} rel="me noopener" target="_blank">Instagram →</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { width: min(100% - 2.4rem, 720px); }
  .page-head { background: var(--navy-700); color: var(--text-on-dark); padding-block: clamp(3rem, 6vw, 5rem); }
  .page-head h1 { color: #fff; font-size: var(--step-4); margin: 0.4rem 0 0.7rem; }
  .lede { color: var(--text-on-dark-dim); font-size: var(--step-1); max-width: 50ch; }

  .card {
    background: var(--paper-soft); border: 1px solid var(--paper-line);
    border-radius: var(--radius); padding: 2rem;
  }
  .kicker {
    font-family: var(--font-body); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.74rem; color: var(--emerald-text); margin-bottom: 0.5rem;
  }
  .mail { display: inline-block; color: #0c7a5c; font-weight: 700; font-size: var(--step-1); word-break: break-all; }
  .note { color: var(--text-on-light-dim); margin-top: 0.6rem; font-size: 0.95rem; }
  .divider { height: 1px; background: var(--paper-line); margin: 1.8rem 0; }
  .social { list-style: none; padding: 0; margin: 0; }
  .social a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 0.2rem;
    color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1.05rem;
  }
  .social a:hover { color: var(--emerald-text); }
</style>
